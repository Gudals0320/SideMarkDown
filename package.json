{
  "name": "sidemarkdown",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:contracts": "node --test tests/extension-contract.test.mjs tests/library.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/extension-e2e.test.mjs tests/library-e2e.test.mjs",
    "test:quality": "npm run build && node --test tests/extension-quality.test.mjs",
    "test": "npm run build && npm run test:contracts",
    "test:all": "npm run build && npm run test:contracts && npm run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@milkdown/kit": "^7.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.1",
    "playwright": "1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
